<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#F59E0B"
                android:centerColor="#D97706"
                android:endColor="#B45309"
                android:type="linear" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1.5dp"
                android:color="#FDE68A" />
        </shape>
    </item>
</ripple>
